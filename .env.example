# Supabase Realtime 설정
# DB 영구 저장은 필요 없으며, Realtime Broadcast / Presence 채널에만 사용됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 최신 API Key: 'Publishable key'를 입력하세요. (구 대시보드의 'anon public' key도 사용 가능)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# (구버전 호환용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# 발표자/프로젝터 화면(/screen) 보안 비밀번호 (서버 전용 환경변수)
# 미설정 시 기본값은 '1234'로 동작합니다.
SCREEN_PASSWORD=your-secret-password-here
